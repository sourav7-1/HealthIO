# Copy to .env for local development. Never commit real secrets.
HIO_ENV=local
HIO_LOG_LEVEL=INFO
HIO_LOG_JSON=false
HIO_CORS_ORIGINS=["http://localhost:5173"]

HIO_DATABASE_URL=postgresql+asyncpg://healthio:healthio@localhost:5433/healthio
HIO_REDIS_URL=redis://localhost:6379/0
HIO_CELERY_BROKER_URL=redis://localhost:6379/1
HIO_CELERY_RESULT_BACKEND=redis://localhost:6379/2

HIO_S3_ENDPOINT_URL=http://localhost:9000
HIO_S3_REGION=ap-south-1
HIO_S3_BUCKET=healthio-local
HIO_S3_ACCESS_KEY_ID=healthio
HIO_S3_SECRET_ACCESS_KEY=healthio-secret

# --- AI prescription reading (AI_SAFETY.md §4; docs/phases/08-ai-prescription-reading.md) ---
# disabled: uploads open the review screen for manual entry. anthropic: Claude reads photos
# (only for patients who allowed AI processing).
HIO_AI_PROVIDER=disabled
# HIO_ANTHROPIC_API_KEY=
HIO_AI_VISION_MODEL=claude-sonnet-5
# none | tesseract (needs the tesseract binary with eng/hin data)
HIO_AI_OCR_ENGINE=none
# true: read inside the request (local dev); false: run on the Celery worker
HIO_AI_JOBS_INLINE=true

# Web Push (Phase 10). Generate a pair with: uv run python scripts/generate_vapid_keys.py
# Without keys, push is off and reminders still appear in the app.
# HIO_WEBPUSH_VAPID_PUBLIC_KEY=
# HIO_WEBPUSH_VAPID_PRIVATE_KEY=
# HIO_WEBPUSH_SUBJECT=mailto:reminders@healthio.local
# HIO_REMINDER_HORIZON_HOURS=48

# Malware scanning of uploads (clamd). Without a host, files that pass the type, size and
# active-content checks are accepted (development only). Production sets both.
# HIO_CLAMAV_HOST=localhost
# HIO_CLAMAV_PORT=3310
# HIO_UPLOAD_VIRUS_SCAN_REQUIRED=true
