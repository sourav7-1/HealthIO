{
  "name": "@health-io/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/schema.d.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').copyFileSync('src/schema.d.ts','dist/schema.d.ts')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": { "openapi-fetch": "^0.17.0" },
  "devDependencies": { "openapi-typescript": "^7.13.0", "typescript": "^5.9.2" }
}
